<Window x:Class="BYOVDMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BYOVD Monitor — vulnerable driver detector"
        Height="760" Width="1060"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ==== Киберпанк-палитра: голубой / жёлтый / розовый на тёмном ==== -->
        <Color x:Key="CyanColor">#FF24E5FF</Color>
        <Color x:Key="PinkColor">#FFFF3DAE</Color>
        <Color x:Key="YellowColor">#FFFFE14D</Color>

        <SolidColorBrush x:Key="Cyan"   Color="{StaticResource CyanColor}"/>
        <SolidColorBrush x:Key="Pink"   Color="{StaticResource PinkColor}"/>
        <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}"/>

        <SolidColorBrush x:Key="Fg"     Color="#FFEAF2FF"/>
        <SolidColorBrush x:Key="FgDim"  Color="#FF8294B4"/>
        <SolidColorBrush x:Key="Panel"  Color="#C6111733"/>
        <SolidColorBrush x:Key="PanelDeep" Color="#E60A0E1F"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#55335BFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#E6070A16"/>

        <!-- Неоновая рамка окна: голубой → розовый → жёлтый по диагонали -->
        <LinearGradientBrush x:Key="NeonFrame" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource CyanColor}" Offset="0"/>
            <GradientStop Color="{StaticResource PinkColor}" Offset="0.55"/>
            <GradientStop Color="{StaticResource YellowColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C614204A" Offset="0"/>
            <GradientStop Color="#C60C1230" Offset="1"/>
        </LinearGradientBrush>

        <!-- ==== Обычные кнопки: голубой неон ==== -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="Background" Value="#33123056"/>
            <Setter Property="BorderBrush" Value="#8824E5FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- мягкое свечение под кнопкой -->
                            <Border x:Name="glow" CornerRadius="3" Background="{TemplateBinding BorderBrush}"
                                    Opacity="0" Margin="-1">
                                <Border.Effect>
                                    <BlurEffect Radius="14"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5518406E"/>
                                <Setter TargetName="glow" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7724E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Акцентная кнопка: розовый неон -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Pink}"/>
            <Setter Property="Background" Value="#33511A3E"/>
            <Setter Property="BorderBrush" Value="#AAFF3DAE"/>
        </Style>

        <!-- Жёлтая кнопка: тревога/внимание -->
        <Style x:Key="YellowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Yellow}"/>
            <Setter Property="Background" Value="#33514A16"/>
            <Setter Property="BorderBrush" Value="#AAFFE14D"/>
        </Style>

        <!-- Кнопки управления окном -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3324E5FF"/>
                                <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Pink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#8824E5FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
        </Style>

        <!-- Заголовки колонок журнала -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="Background" Value="#CC0B1026"/>
            <Setter Property="BorderBrush" Value="#55335BFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Строки журнала -->
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#2224E5FF" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2224E5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FF3DAE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строки списка папок -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A24E5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2624E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Мигание ореола лампы при тревоге -->
        <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LampGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.12" Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    <!-- ======= Корпус окна: нестандартная форма + неоновая рамка + свечение ======= -->
    <Border x:Name="RootBorder" Background="{StaticResource PanelDeep}"
            BorderBrush="{StaticResource NeonFrame}" BorderThickness="1.6"
            CornerRadius="20,5,20,5">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource CyanColor}" BlurRadius="34" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>   <!-- титульная строка -->
                <RowDefinition Height="Auto"/> <!-- база хешей -->
                <RowDefinition Height="Auto"/> <!-- лампа + папки -->
                <RowDefinition Height="*"/>    <!-- журнал -->
                <RowDefinition Height="Auto"/> <!-- статус -->
            </Grid.RowDefinitions>

            <!-- ===== Титульная строка: бренд с дисперсией + управление окном ===== -->
            <Grid Grid.Row="0" Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ромб-эмблема -->
                <Rectangle Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5" Fill="{StaticResource NeonFrame}">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.RenderTransform>
                    <Rectangle.Effect>
                        <DropShadowEffect Color="{StaticResource PinkColor}" BlurRadius="12" ShadowDepth="0"/>
                    </Rectangle.Effect>
                </Rectangle>

                <!-- Бренд с хроматической дисперсией (голубой + розовый ghost, белый поверх) -->
                <Grid Grid.Column="0" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BYOVD MONITOR" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Cyan}" Margin="-2,0,0,0" Opacity="0.85"/>
                    <TextBlock Text="BYOVD MONITOR" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Pink}" Margin="2,0,0,0" Opacity="0.85"/>
                    <TextBlock Text="BYOVD MONITOR" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Fg}"/>
                </Grid>

                <TextBlock Grid.Column="1" Text="vulnerable driver detector" VerticalAlignment="Center"
                           Margin="22,2,0,0" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource FgDim}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource WinBtn}" Content="—" Click="OnMinimizeClick" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource WinBtn}" Content="▢"
                            Click="OnMaximizeClick" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseBtn}" Content="✕" Click="OnCloseClick" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ===== База хешей ===== -->
            <Border Grid.Row="1" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="10,3,10,3" Padding="16,11" Margin="14,4,14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="HASH DATABASE" FontFamily="Consolas" FontSize="12"
                                   FontWeight="Bold" Foreground="{StaticResource Yellow}"/>
                        <TextBlock x:Name="ListStatusText" Margin="0,3,0,0" FontFamily="Consolas"
                                   Foreground="{StaticResource FgDim}" Text="Hash list not loaded"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DownloadButton" Content="Download list"
                                Style="{StaticResource AccentButton}" Click="OnDownloadClick" Margin="0,0,8,0"/>
                        <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="OnCheckUpdateClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Лампа-индикатор + папки ===== -->
            <Grid Grid.Row="2" Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Индикатор -->
                <Border Grid.Column="0" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="10,3,10,3" Padding="14" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Height="178" Width="178" HorizontalAlignment="Center">
                            <!-- внешнее кольцо -->
                            <Ellipse Width="150" Height="150" Stroke="#3324E5FF" StrokeThickness="1"
                                     StrokeDashArray="1 3"/>
                            <Ellipse x:Name="LampGlow" Width="168" Height="168" Opacity="0.5">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="44"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="LampGlass" Width="116" Height="116" Stroke="#FF060814" StrokeThickness="2"/>
                            <!-- блик -->
                            <Ellipse Width="40" Height="40" Margin="0,26,40,0"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="StatusText" Text="Idle" FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="StatusSubText" Text="Monitoring not running"
                                   Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="Consolas"/>
                        <Button x:Name="ClearAlertButton" Content="Clear alert" Margin="0,14,0,0"
                                Style="{StaticResource YellowButton}" Click="OnClearAlertClick" IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <!-- Папки -->
                <Border Grid.Column="1" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="10,3,10,3" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="MONITORED FOLDERS" FontFamily="Consolas"
                                   FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,8"/>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderPathBox" Grid.Column="0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="OnBrowseClick"/>
                            <CheckBox x:Name="SubfoldersCheck" Grid.Column="2" Content="Subfolders" Margin="10,0,0,0"/>
                            <Button Grid.Column="3" Content="Add" Style="{StaticResource AccentButton}"
                                    Margin="8,0,0,0" Click="OnAddFolderClick"/>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="6,2,6,2">
                            <ListBox x:Name="FoldersList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Fg}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Path}" FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="incl. subfolders" FontSize="11"
                                                           Foreground="{StaticResource Yellow}"
                                                           Visibility="{Binding IncludeSubdirectories,
                                                               Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Remove" Padding="8,2"
                                                    Tag="{Binding}" Click="OnRemoveFolderClick"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Scan now" Style="{StaticResource YellowButton}" Click="OnScanNowClick"/>
                            <CheckBox x:Name="SoundCheck" Content="Sound on detection" Margin="16,0,0,0"
                                      IsChecked="True" Checked="OnSoundToggle" Unchecked="OnSoundToggle"/>
                            <CheckBox x:Name="MhrCheck" Content="Team Cymru MHR (DNS)"
                                      Margin="16,0,0,0" Checked="OnMhrToggle" Unchecked="OnMhrToggle"/>
                            <CheckBox x:Name="DriverWatchCheck" Content="Watch driver installs"
                                      Margin="16,0,0,0" Checked="OnDriverWatchToggle" Unchecked="OnDriverWatchToggle"/>
                            <CheckBox x:Name="SigCheck" Content="Flag bad signatures"
                                      Margin="16,0,0,0" Checked="OnSigToggle" Unchecked="OnSigToggle"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Журнал обнаружений ===== -->
            <Border Grid.Row="3" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="10,3,10,3" Padding="14" Margin="14,12,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="DETECTED VULNERABLE DRIVERS" FontFamily="Consolas"
                               FontWeight="Bold" Foreground="{StaticResource Pink}" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="{StaticResource InputBg}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="6,2,6,2">
                        <ListView x:Name="DetectionsList" Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource Fg}" MouseDoubleClick="OnDetectionDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Time" Width="150" DisplayMemberBinding="{Binding TimeText}"/>
                                    <GridViewColumn Header="Confidence" Width="95" DisplayMemberBinding="{Binding Confidence}"/>
                                    <GridViewColumn Header="Source" Width="160" DisplayMemberBinding="{Binding Source}"/>
                                    <GridViewColumn Header="Match" Width="220" DisplayMemberBinding="{Binding DriverName}"/>
                                    <GridViewColumn Header="File" Width="150" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="Path" Width="300" DisplayMemberBinding="{Binding FilePath}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Check file…" Style="{StaticResource AccentButton}" Click="OnCheckFileClick"/>
                        <Button Content="Open folder" Margin="8,0,0,0" Click="OnOpenFolderClick"/>
                        <Button Content="Copy SHA-256" Margin="8,0,0,0" Click="OnCopyHashClick"/>
                        <Button Content="Clear log" Margin="8,0,0,0" Click="OnClearLogClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Нижняя строка состояния ===== -->
            <Border Grid.Row="4" Margin="16,10,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{StaticResource Cyan}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{StaticResource CyanColor}" BlurRadius="8" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="StatusBarText" Grid.Column="1" Foreground="{StaticResource FgDim}"
                               FontFamily="Consolas" VerticalAlignment="Center"
                               Text="Ready" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
